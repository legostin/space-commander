{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Space Commander",
  "version": "0.1.0",
  "identifier": "app.spacecommander.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Space Commander",
        "width": 1360,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#08090e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Space Commander",
    "shortDescription": "Disk space analyzer",
    "longDescription": "Fast disk space analyzer for Windows: disk map, cache cleanup, scheduled tasks.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
